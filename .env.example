# Copiar a .env y completar. .env no se versiona (RNF-04).

# Firma la cookie de sesión. Obligatoria: sin ella la app no arranca (RF-57).
# Generarla con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Opcional. Por defecto, movimientos.db en la raíz del repo.
# DATABASE_URL=sqlite:////ruta/absoluta/movimientos.db

# Servidor de correo para el mail diario a los socios (RNF-04). Para Gmail:
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SEGURIDAD=starttls,
#   SMTP_PASSWORD = contraseña de aplicación de 16 caracteres
#   (https://myaccount.google.com/apppasswords) y SMTP_FROM igual a SMTP_USER.
# Formato CLAVE=valor, sin espacios ni comillas. Reiniciar uvicorn después de cambiarlo.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SEGURIDAD=starttls
